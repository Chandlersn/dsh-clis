import { appendFileSync, mkdirSync } from 'node:fs';
import { join } from 'node:path';

import type { Context } from '@deepseek-ai/cordis';

import {
  CAUSAL_CLASSIFIER_SERVICE,
  CAUSAL_FEEDBACK_SERVICE,
  CAUSAL_ORCHESTRATOR_SERVICE,
  CAUSAL_STRATEGY_SERVICE,
} from '@clis/clis-contracts';
import type {
  ActionExecutor,
  CausalClassification,
  CausalProblem,
  CandidatePath,
  ExecutionResult,
  FeedbackSignal,
  OrchestratorDecision,
  StrategyBoundary,
} from '@clis/clis-contracts';

/** 一次验收运行的完整记录（落盘单位）。 */
export interface AcceptanceRecord {
  readonly scenario_id: string;
  readonly scenario_name: string;
  readonly input: { readonly description: string; readonly answers: CausalProblem['answers'] };
  /** ① 因果类型标签 */
  readonly causal_type: string;
  readonly confidence: number;
  /** ② 判断依据 */
  readonly judgment_basis: readonly { rule_id: string; description: string; fired: boolean; effect?: string }[];
  readonly evidence: readonly string[];
  /** ③ 优化边界 */
  readonly boundary: StrategyBoundary;
  /** ④ 禁止动作 */
  readonly forbidden_actions: readonly string[];
  /** 策略选择 */
  readonly chosen_path: { path_id: string; variant: string; rank: number; score: number; summary: string };
  readonly candidates: readonly { variant: string; rank: number; score: number; executable: boolean }[];
  /** 执行与反馈 */
  readonly execution_status: ExecutionResult['status'];
  readonly signal_type: FeedbackSignal['signal_type'];
  readonly signal_reason: string;
  readonly suggested_rollback?: { kind: string; target_type: string; rationale: string };
  /** 编排决策 */
  readonly decision: { action: string; reason: string; rollback_count: number; retry_type?: string };
  /** 完整 trace */
  readonly traces: readonly { round: number; causal_type: string; action: string; rollback_count: number; note: string }[];
  readonly outcome: string;
  /** 断言结果 */
  readonly assertions: readonly { name: string; passed: boolean; detail: string }[];
  readonly recorded_at: string;
}

const RUNS_DIR = join(process.cwd(), 'reports', 'acceptance-runs');
const RUNS_FILE = join(RUNS_DIR, 'runs.jsonl');

/** 把一条记录追加落盘（JSONL，逐行可回溯）。 */
export function persistRecord(record: AcceptanceRecord): string {
  mkdirSync(RUNS_DIR, { recursive: true });
  appendFileSync(RUNS_FILE, `${JSON.stringify(record)}\n`, 'utf8');
  return RUNS_FILE;
}

export const RUNS_PATH = RUNS_FILE;

export interface RunOneOptions {
  readonly ctx: Context;
  readonly scenarioId: string;
  readonly scenarioName: string;
  readonly problem: CausalProblem;
  readonly boundary: StrategyBoundary;
  readonly executor: ActionExecutor;
  /** 强制假定类型（用于构造误判场景）；缺省用分类器真实结论。 */
  readonly assumedType?: string;
  /** 历史轨迹（用于构造"反复偏离"）。 */
  readonly previousSignals?: readonly string[];
}

/** 跑一个场景，产出完整记录（含四要素与断言素材）。 */
export async function runOne(options: RunOneOptions): Promise<AcceptanceRecord> {
  const { ctx, problem, boundary, executor } = options;

  const classifier = ctx[CAUSAL_CLASSIFIER_SERVICE];
  const strategy = ctx[CAUSAL_STRATEGY_SERVICE];
  const feedback = ctx[CAUSAL_FEEDBACK_SERVICE];
  const orchestrator = ctx[CAUSAL_ORCHESTRATOR_SERVICE];

  // ① 判断
  const classification: CausalClassification = await classifier.classify(problem);

  // ② 匹配 + 执行
  const candidates = await strategy.match(classification, boundary);
  const chosen: CandidatePath | undefined =
    candidates.find((candidate) => candidate.executable) ?? candidates[0];
  if (chosen === undefined) throw new Error(`场景 ${options.scenarioId}：无候选路径`);

  const execution = await strategy.execute(chosen, { boundary, executor });

  // ③ 反馈（误判场景用强制假定类型 + 历史轨迹）
  const assumedType = (options.assumedType ?? classification.causal_type) as typeof classification.causal_type;
  const signal = await feedback.detect(
    {
      result: execution,
      classification: { causal_type: assumedType, confidence: classification.confidence },
      boundary: { forbidden_actions: boundary.forbidden_actions },
    },
    options.previousSignals === undefined
      ? undefined
      : { previous_signals: options.previousSignals as never },
  );

  // ④ 编排决策（单轮）
  const { decision, nextState } = await orchestrator.decide(
    {
      problem,
      boundary,
      path: chosen,
      execution,
      signal,
      causal_type: classification.causal_type,
    },
    { round: 0, rollback_count: 0, oscillation: { consecutive_rollbacks: {}, lock_remaining: 0 }, traces: [] },
  );

  return {
    scenario_id: options.scenarioId,
    scenario_name: options.scenarioName,
    input: { description: problem.description, answers: problem.answers },
    causal_type: classification.causal_type,
    confidence: classification.confidence,
    judgment_basis: classification.judgment_basis.map((item) => ({ ...item })),
    evidence: classification.evidence.map((item) => item.statement),
    boundary,
    forbidden_actions: boundary.forbidden_actions,
    chosen_path: {
      path_id: chosen.path_id,
      variant: chosen.variant,
      rank: chosen.rank,
      score: chosen.score,
      summary: chosen.summary,
    },
    candidates: candidates.map((candidate) => ({
      variant: candidate.variant,
      rank: candidate.rank,
      score: candidate.score,
      executable: candidate.executable,
    })),
    execution_status: execution.status,
    signal_type: signal.signal_type,
    signal_reason: signal.reason,
    ...(signal.suggested_rollback === undefined
      ? {}
      : {
          suggested_rollback: {
            kind: signal.suggested_rollback.kind,
            target_type: signal.suggested_rollback.target_type,
            rationale: signal.suggested_rollback.rationale,
          },
        }),
    decision: {
      action: decision.action,
      reason: decision.reason,
      rollback_count: decision.rollback_count,
      ...(decision.retry_type === undefined ? {} : { retry_type: decision.retry_type }),
    },
    traces: nextState.traces.map((trace) => ({
      round: trace.round,
      causal_type: trace.causal_type,
      action: trace.action,
      rollback_count: trace.rollback_count,
      note: trace.note,
    })),
    outcome: decision.action === 'continue' ? 'effective' : decision.action,
    assertions: [],
    recorded_at: new Date().toISOString(),
  };
}

/** 简单断言收集器：让记录里带"这条过了没有"。 */
export function collect(
  record: AcceptanceRecord,
  checks: readonly { name: string; passed: boolean; detail: string }[],
): AcceptanceRecord {
  return { ...record, assertions: checks };
}

export type { OrchestratorDecision };
